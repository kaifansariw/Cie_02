@* ==============================================================================
   OrderConfirmation.cshtml (Product)
   Online Shopping Product Management System
   Clean, authentic order receipt and purchase confirmation page.
   ============================================================================== *@
@model OnlineShoppingSystem.Models.OrderViewModel

@{
    ViewData["Title"] = "Order Confirmation #" + Model.OrderReferenceNumber;
}

<div class="container py-4" style="max-width: 850px;">
    @* Success Header *@
    <div class="text-center mb-4">
        <div class="d-inline-flex p-3 bg-success bg-opacity-10 text-success rounded-circle mb-3">
            <i class="bi bi-check2-circle fs-1"></i>
        </div>
        <h2 class="fw-bold text-dark mb-1">Thank You For Your Order!</h2>
        <p class="text-muted">
            We've received your purchase, <strong class="text-primary">@Model.CustomerName</strong>. A confirmation has been sent to your email.
        </p>
    </div>

    @* Receipt Card Container *@
    <div class="receipt-card modern-card p-4 p-md-5 mb-4 shadow-lg">
        <div class="d-flex justify-content-between align-items-center pb-4 border-bottom flex-wrap gap-2">
            <div>
                <span class="badge bg-secondary-subtle text-secondary px-3 py-1 rounded-pill small fw-bold">OFFICIAL RECEIPT</span>
                <h4 class="fw-bold text-dark mt-2 mb-0">ShopCore MVC</h4>
            </div>
            <div class="text-md-end">
                <div class="fw-bold font-monospace text-primary">@Model.OrderReferenceNumber</div>
                <small class="text-muted">@Model.OrderTimestamp.ToString("MMM dd, yyyy HH:mm")</small>
            </div>
        </div>

        @* Customer & Dispatch Details *@
        <div class="row g-3 py-4 border-bottom">
            <div class="col-sm-6">
                <small class="text-muted text-uppercase fw-bold" style="font-size: 0.75rem;">Billed To:</small>
                <div class="fw-bold text-dark mt-1">@Model.CustomerName</div>
                <div class="text-muted small">@Model.CustomerEmail</div>
            </div>
            <div class="col-sm-6">
                <small class="text-muted text-uppercase fw-bold" style="font-size: 0.75rem;">Shipping Address & Payment:</small>
                <div class="fw-semibold text-dark mt-1">@Model.ShippingAddress</div>
                <div class="text-muted small"><i class="bi bi-credit-card me-1"></i> Paid via @Model.PaymentMethod</div>
            </div>
        </div>

        @* Ordered Item Details Table *@
        <div class="table-responsive my-4">
            <table class="table custom-table">
                <thead>
                    <tr>
                        <th>Item Description</th>
                        <th class="text-center">Item #</th>
                        <th class="text-end">Retail Price</th>
                        <th class="text-end">Discount</th>
                        <th class="text-end">Unit Price</th>
                        <th class="text-center">Qty</th>
                        <th class="text-end">Total</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>
                            <div class="fw-bold text-dark">@(Model.Product?.ProductName ?? "Product #" + Model.ProductId)</div>
                            <small class="badge bg-light text-secondary border">@(Model.Product?.Category ?? "Retail")</small>
                        </td>
                        <td class="text-center text-muted font-monospace">
                            #@Model.ProductId
                        </td>
                        <td class="text-end text-muted">
                            $@Model.UnitPrice.ToString("N2")
                        </td>
                        <td class="text-end text-danger fw-semibold">
                            -@Model.DiscountPercentage%
                        </td>
                        <td class="text-end fw-bold text-primary">
                            $@Model.UnitDiscountedPrice.ToString("N2")
                        </td>
                        <td class="text-center fw-semibold">
                            @Model.Quantity
                        </td>
                        <td class="text-end fw-bold text-dark fs-6">
                            $@Model.TotalAmount.ToString("N2")
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        @* Price Summary Totals *@
        <div class="p-4 bg-light rounded-4 border">
            <div class="d-flex justify-content-between mb-2">
                <span class="text-muted">Subtotal:</span>
                <span class="text-muted">$@((Model.UnitPrice * Model.Quantity).ToString("N2"))</span>
            </div>
            <div class="d-flex justify-content-between mb-2 text-danger">
                <span>Discount Savings:</span>
                <span class="fw-bold">-$@Model.TotalSavings.ToString("N2")</span>
            </div>
            <hr class="my-2" />
            <div class="d-flex justify-content-between align-items-center pt-1">
                <div>
                    <span class="fs-5 fw-bold text-dark d-block">Grand Total:</span>
                    <small class="text-success fw-semibold">You saved $@Model.TotalSavings.ToString("N2") on this purchase!</small>
                </div>
                <span class="discounted-price-highlight fs-2">
                    $@Model.TotalAmount.ToString("N2")
                </span>
            </div>
        </div>
    </div>

    @* Navigation Buttons *@
    <div class="d-flex gap-3 justify-content-center">
        <a asp-action="Index" class="btn btn-primary-custom px-4 py-2">
            <i class="bi bi-cart3 me-1"></i> Continue Shopping
        </a>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-custom px-4 py-2">
            <i class="bi bi-house me-1"></i> Back to Home
        </a>
    </div>
</div>
