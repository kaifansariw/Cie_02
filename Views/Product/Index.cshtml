@* ==============================================================================
   Index.cshtml (Product)
   Online Shopping Product Management System
   Customer-facing product catalog with category filter, search, table & card view.
   ============================================================================== *@
@model OnlineShoppingSystem.Models.ProductCatalogViewModel

@{
    ViewData["Title"] = "Product Catalog";
}

<div class="container-fluid px-0">
    @* --------------------------------------------------------------------------
       Welcome Header & Search Bar
       -------------------------------------------------------------------------- *@
    <div class="modern-card p-4 mb-4 bg-white">
        <div class="row align-items-center g-3">
            <div class="col-md-7">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-3 bg-primary bg-opacity-10 rounded-circle text-primary">
                        <i class="bi bi-bag-heart fs-2"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-1">
                            @if (!string.IsNullOrWhiteSpace(Model.CustomerName))
                            {
                                <span>Welcome back, <span class="text-primary">@Model.CustomerName</span>! 👋</span>
                            }
                            else
                            {
                                <span>Explore Our Products</span>
                            }
                        </h4>
                        <p class="text-muted small mb-0">
                            Find the best deals across all categories with instant discount calculations.
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-md-5 text-md-end">
                <button type="button" class="btn btn-outline-custom" data-bs-toggle="modal" data-bs-target="#customerModal">
                    <i class="bi bi-person me-1"></i>
                    @(string.IsNullOrWhiteSpace(Model.CustomerName) ? "Set Your Name" : "Edit Profile")
                </button>
            </div>
        </div>
    </div>

    @* --------------------------------------------------------------------------
       Category Filter & View Mode Controls
       -------------------------------------------------------------------------- *@
    <div class="modern-card p-4 mb-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3">
            <div>
                <h5 class="fw-bold mb-1">Categories</h5>
                <p class="text-muted small mb-0">Browse by department</p>
            </div>
            @* View Mode Switcher (Table vs Grid) *@
            <div class="btn-group" role="group" aria-label="View switch">
                <button type="button" id="viewTableBtn" class="btn btn-sm btn-primary">
                    <i class="bi bi-table me-1"></i> Table View
                </button>
                <button type="button" id="viewGridBtn" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-grid-3x3 me-1"></i> Grid View
                </button>
            </div>
        </div>

        @* Category filter chips *@
        <div class="d-flex flex-wrap gap-2 align-items-center pt-1">
            <a asp-action="Index" asp-route-category="all"
               class="category-chip @(string.IsNullOrEmpty(Model.SelectedCategory) ? "active" : "")">
                All Products (@Model.Products.Count())
            </a>

            @foreach (var cat in Model.Categories)
            {
                bool isSelected = string.Equals(Model.SelectedCategory, cat, StringComparison.OrdinalIgnoreCase);
                <a asp-action="Index" asp-route-category="@cat"
                   class="category-chip @(isSelected ? "active" : "")">
                    @cat.ToUpperInvariant()
                </a>
            }

            @if (!string.IsNullOrEmpty(Model.SelectedCategory))
            {
                <a asp-action="ClearCategorySession" class="btn btn-sm btn-link text-danger text-decoration-none ms-2">
                    <i class="bi bi-x-circle me-1"></i> Clear Filter
                </a>
            }
        </div>
    </div>

    @* --------------------------------------------------------------------------
       Product Table Display
       -------------------------------------------------------------------------- *@
    <div id="catalogTableView" class="modern-card mb-5 overflow-hidden">
        <div class="p-3 bg-light border-bottom d-flex align-items-center justify-content-between">
            <span class="fw-bold text-dark">
                <i class="bi bi-box-seam text-primary me-2"></i> All Products
            </span>
            <span class="text-muted small">Showing @Model.Products.Count() items</span>
        </div>

        <div class="table-responsive">
            <table class="table custom-table align-middle">
                <thead>
                    <tr>
                        <th style="width: 70px;">ID</th>
                        <th style="width: 80px;">Preview</th>
                        <th>Product Title</th>
                        <th>Category</th>
                        <th>Original Price</th>
                        <th>Discount</th>
                        <th>Final Price</th>
                        <th class="text-center" style="width: 140px;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Products.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                No products found matching this filter.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Products)
                        {
                            <tr>
                                @* Product ID *@
                                <td class="fw-bold text-muted">
                                    #@item.ProductId
                                </td>

                                @* Product Thumbnail *@
                                <td>
                                    <div class="bg-white p-1 rounded border text-center" style="width: 50px; height: 50px;">
                                        <img src="@item.Image" alt="@item.ProductName" class="w-100 h-100 object-fit-contain" />
                                    </div>
                                </td>

                                @* Product Title *@
                                <td>
                                    <div class="fw-bold text-dark">@item.ProductName</div>
                                    <small class="text-muted text-truncate-2" style="max-width: 400px; display: inline-block;">
                                        @item.Description
                                    </small>
                                </td>

                                @* Category *@
                                <td>
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill text-uppercase" style="font-size: 0.72rem;">
                                        @item.Category
                                    </span>
                                </td>

                                @* Original Price *@
                                <td>
                                    <span class="@(item.HasDiscount() ? "original-price-strike" : "fw-bold text-dark")">
                                        $@item.Price.ToString("N2")
                                    </span>
                                </td>

                                @* Discount Percentage *@
                                <td>
                                    @if (item.HasDiscount())
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle fw-bold">
                                            -@item.DiscountPercentage%
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">0%</span>
                                    }
                                </td>

                                @* Final Discounted Price *@
                                <td>
                                    <span class="fw-bold text-primary fs-6">
                                        $@item.GetDiscountedPrice().ToString("N2")
                                    </span>
                                    @if (item.HasDiscount())
                                    {
                                        <div class="small text-success fw-semibold">
                                            Save $@item.GetSavingsAmount().ToString("N2")
                                        </div>
                                    }
                                </td>

                                @* View Details Action *@
                                <td class="text-center">
                                    <a asp-action="Details" asp-route-id="@item.ProductId"
                                       class="btn btn-sm btn-outline-primary fw-semibold">
                                        <i class="bi bi-eye me-1"></i> View Details
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    @* --------------------------------------------------------------------------
       Grid View (Toggled via Switcher)
       -------------------------------------------------------------------------- *@
    <div id="catalogGridView" class="row g-4 mb-5 d-none">
        @foreach (var item in Model.Products)
        {
            <div class="col-sm-6 col-lg-4 col-xl-3">
                <div class="modern-card h-100 d-flex flex-column">
                    <div class="position-relative p-4 text-center bg-white border-bottom" style="height: 220px;">
                        @if (item.HasDiscount())
                        {
                            <span class="position-absolute top-0 start-0 m-3 discount-badge">
                                -@item.DiscountPercentage% OFF
                            </span>
                        }
                        <img src="@item.Image" alt="@item.ProductName" class="img-fluid h-100 object-fit-contain" />
                    </div>
                    <div class="p-4 d-flex flex-column justify-content-between flex-grow-1">
                        <div>
                            <span class="badge bg-light text-secondary border small text-uppercase mb-2">
                                @item.Category
                            </span>
                            <h6 class="fw-bold text-truncate-2 mb-2" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; height: 42px;">
                                @item.ProductName
                            </h6>
                            <p class="text-muted small text-truncate-2" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; height: 38px;">
                                @item.Description
                            </p>
                        </div>
                        <div class="mt-3 pt-3 border-top">
                            <div class="d-flex align-items-baseline gap-2 mb-3">
                                <span class="discounted-price-highlight">
                                    $@item.GetDiscountedPrice().ToString("N2")
                                </span>
                                @if (item.HasDiscount())
                                {
                                    <span class="original-price-strike">
                                        $@item.Price.ToString("N2")
                                    </span>
                                }
                            </div>
                            <a asp-action="Details" asp-route-id="@item.ProductId"
                               class="btn btn-primary-custom w-100 text-center">
                                View Details
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
